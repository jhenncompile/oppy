# --- Servidor ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# --- Base de datos ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oppy
# Render, Supabase y la mayoria de hosts gestionados exigen SSL
DATABASE_SSL=false

# Supabase (proyecto Oppy):
#   URL: https://bowwejtpewzhlksioxnb.supabase.co
# Usar la cadena del "Session pooler" (Project Settings > Database),
# no la conexion directa — la directa solo resuelve por IPv6.
#
#   DATABASE_URL=postgresql://postgres.bowwejtpewzhlksioxnb:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   DATABASE_SSL=true
#   SUPABASE_URL=https://bowwejtpewzhlksioxnb.supabase.co
#
# Pasos: docs/11-supabase.md
# Feedback → IA: al guardar/descartar matches, el scoring Oppy usa esas senales.
# Export para reentrenar LoRA: node scripts/export-feedback-jsonl.js

# --- LLM ---
# Toda llamada al modelo pasa por services/llm, asi que cambiar de proveedor
# es configuracion, no refactor.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# qwen3:8b / mistral:7b / llama3.1:8b — el que tengas en `ollama list`
# En laptops con poca VRAM, mistral:7b suele ser mas estable para JSON.
OLLAMA_MODEL=mistral:7b
LLM_TIMEOUT_MS=180000

# API del agente LoRA (Modal / serve_oppy_api.py).
# Si esta seteada, normalize/match usan SOLO Oppy (sin fallback a Ollama).
OPPY_API_URL=

# --- Descubrimiento ---
EXA_API_KEY=
FIRECRAWL_API_KEY=

# --- Notificaciones (Zavu — https://zavu.dev) ---
# Mensajeria unificada: Zavu elige el canal segun el formato del destinatario y
# reintenta por otro si el primero falla.
ZAVUDEV_API_KEY=
# Sin Zavu: en development el acceso por codigo sigue activo y el codigo
# se imprime en los logs del backend.
AUTH_DEV_LOG_CODE=true
# Por debajo de este puntaje no se molesta a nadie.
NOTIF_MATCH_THRESHOLD=80
# Tope por persona y por corrida: cinco mensajes seguidos no son un
# acompaniante, son spam.
NOTIF_MAX_POR_USUARIO=3

# --- Agente ---
# Cuantos resultados pedir por query semantica
EXA_RESULTS_PER_QUERY=8
# Cuantas oportunidades puntuar por corrida (control de costo)
MAX_SCORING_PER_RUN=40

# --- Cron ---
# El indice es compartido: el cron descubre una vez para todos.
CRON_ENABLED=false
CRON_SCHEDULE=0 6 * * *

# --- Desarrollo ---
# Reemplaza descubrimiento y evaluacion por un catalogo de ejemplo. Permite ver
# la interfaz completa sin claves de Exa/Firecrawl y sin un modelo servido.
# Solo para desarrollo: render.yaml no define esta variable.
DEMO_MODE=false

# --- Contacto de la demo ---
# A donde llega el aviso de Zavu en una demostracion en vivo. Se aplica al
# perfil de reinsercion que crea el seed; sin esto, nadie recibe nada.
#
# NO poner valores reales aca: este archivo se versiona. Van en backend/.env.
# El telefono en formato internacional (+591...), porque Zavu elige el canal
# por el formato del destinatario.
DEMO_CONTACTO_EMAIL=
DEMO_CONTACTO_TELEFONO=
