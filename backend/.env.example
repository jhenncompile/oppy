# --- Servidor ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# --- Base de datos ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oppy
# Render y la mayoria de hosts gestionados exigen SSL
DATABASE_SSL=false

# --- LLM ---
# Toda llamada al modelo pasa por services/llm, asi que cambiar de proveedor
# es configuracion, no refactor.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# qwen3:8b / mistral:7b / llama3.1:8b — el que tengas en `ollama list`
# En laptops con poca VRAM, mistral:7b suele ser mas estable para JSON.
OLLAMA_MODEL=mistral:7b
LLM_TIMEOUT_MS=180000

# API del agente LoRA (serve_oppy_api.py). Dejar vacio para usar solo Ollama.
# Si esta seteada, normalize/match usan Oppy y caen a Ollama si falla.
OPPY_API_URL=

# --- Descubrimiento ---
EXA_API_KEY=
FIRECRAWL_API_KEY=

# --- Notificaciones (Zavu — https://zavu.dev) ---
# Mensajeria unificada: Zavu elige el canal segun el formato del destinatario y
# reintenta por otro si el primero falla.
ZAVUDEV_API_KEY=
# Por debajo de este puntaje no se molesta a nadie.
NOTIF_MATCH_THRESHOLD=80
# Tope por persona y por corrida: cinco mensajes seguidos no son un
# acompaniante, son spam.
NOTIF_MAX_POR_USUARIO=3

# --- Agente ---
# Cuantos resultados pedir por query semantica
EXA_RESULTS_PER_QUERY=8
# Cuantas oportunidades puntuar por corrida (control de costo)
MAX_SCORING_PER_RUN=40

# --- Cron ---
# El indice es compartido: el cron descubre una vez para todos.
CRON_ENABLED=false
CRON_SCHEDULE=0 6 * * *

# --- Desarrollo ---
# Reemplaza descubrimiento y evaluacion por un catalogo de ejemplo. Permite ver
# la interfaz completa sin claves de Exa/Firecrawl y sin un modelo servido.
# Solo para desarrollo: render.yaml no define esta variable.
DEMO_MODE=false
